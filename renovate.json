{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "baseBranchPatterns": ["dev", "v5"],
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["alexa-fhem"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["ghcr.io/fhem/alexa-fhem"],
      "pinDigests": false,
      "automerge": true
    },
    {
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["ghcr.io/fhem/alexa-fhem"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["pin", "digest"],
      "automerge": true
    },
    {
      "description": "v5 maintenance branch: no major updates of Node or the alexa-fhem image",
      "matchBaseBranches": ["v5"],
      "matchPackageNames": ["node", "ghcr.io/fhem/alexa-fhem"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
