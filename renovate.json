{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "docker:pinDigests"
  ],
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["alexa-fhem"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["ghcr.io/fhem/alexa-fhem"],
      "pinDigests": false,
      "automerge": true
    },
    {
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["pin", "digest"],
      "automerge": true
    }
  ]
}
